# -------------------------------------------------------------------------
package-lock.json
package.json
vite.generated.ts
types.d.ts
tsconfig.json
frontend/generated/
**/frontend/generated/

# -------------------------------------------------------------------------
# Node.js & Angular (Frontend)
# -------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/.angular/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -------------------------------------------------------------------------
# IDEs & Editors
# -------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iml
*.iws
*.ipr
out/
**/out/

# Visual Studio Code
.vscode/
**/.vscode/
*.code-workspace

# Eclipse
.classpath
.project
.settings/
**/.settings/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# -------------------------------------------------------------------------
# Operating System & Environment
# -------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Linux
*~
.directory

# Environment variables & local secrets
.env
.env.local
.env.*.local
