# -------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Wrapper & temp
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# -------------------------------------------------------------------------
